# ESS RAG Bot Configuration
# Replace with your actual API keys

# Groq API Key (for fast LLM responses)
GROQ_API_KEY=gsk_your_groq_api_key_here

# LLM Provider: "groq" (fast, 2-3s) or "ollama" (free, slow 15-30s)
LLM_PROVIDER=groq

# Telegram Bot Tokens
# Bot 1 (Lightweight - PythonAnywhere): For 24/7 availability, redirects to web app
TELEGRAM_BOT_TOKEN_LIGHTWEIGHT=your_lightweight_bot_token_here

# Bot 2 (Full RAG - Local): For direct answers when your PC is running
# Format: 123456789:ABCdefGHIjklMNOpqrsTUVwxyz-1234567
TELEGRAM_BOT_TOKEN=your_full_bot_token_here
