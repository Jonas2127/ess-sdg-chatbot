{
  "version": 2,
  "builds": [
    {
      "src": "telegram_webhook.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "telegram_webhook.py"
    }
  ],
  "env": {
    "TELEGRAM_BOT_TOKEN": "@telegram_bot_token",
    "GROQ_API_KEY": "@groq_api_key",
    "LLM_PROVIDER": "groq"
  }
}
