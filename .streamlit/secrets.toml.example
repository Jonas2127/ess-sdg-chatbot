# Streamlit Cloud Secrets Configuration
# ======================================
# Copy these to Streamlit Cloud dashboard:
# App Settings → Secrets → Paste content below
# ======================================

# Groq API Configuration (FREE tier - get at https://console.groq.com)
GROQ_API_KEY = "your-groq-api-key-here"

# LLM Provider (use "groq" for fast cloud deployment)
LLM_PROVIDER = "groq"

